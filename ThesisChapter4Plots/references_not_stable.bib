	booktitle = {Adaptive {Optics} {Systems} {VIII}},
	publisher = {SPIE},
	author = {Busoni, Lorenzo and Agapito, Guido and Plantet, Cédric and Carlà, Giulia and Oberti, Sylvain and Bonaglia, Marco and Lapucci, Tommaso and Xompero, Marco and Arcidiacono, Carmelo and Hubert, Zoltan and Rabou, Patrick and Salasnich, Bernardo and Baruffolo, Andrea and Foppiani, Italo and Pariani, Giorgio M. and Munari, Matteo and Magrin, Demetrio and Riva, Marco and Ciliegi, Paolo},
