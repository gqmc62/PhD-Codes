@inproceedings{marchetti_first_2014,
	address = {Montréal, Quebec, Canada},
	title = {First on-sky results of a neural network based tomographic reconstructor: {Carmen} on {Canary}},
	shorttitle = {First on-sky results of a neural network based tomographic reconstructor},
	url = {http://proceedings.spiedigitallibrary.org/proceeding.aspx?doi=10.1117/12.2057462},
	doi = {10.1117/12.2057462},
	abstract = {We present on-sky results obtained with Carmen, an artiﬁcial neural network tomographic reconstructor. It was tested during two nights in July 2013 on Canary, an AO demonstrator on the William Hershel Telescope. Carmen is trained during the day on the Canary calibration bench. This training regime ensures that Carmen is entirely ﬂexible in terms of atmospheric turbulence proﬁle, negating any need to re-optimise the reconstructor in changing atmospheric conditions. Carmen was run in short bursts, interlaced with an optimised Learn and Apply reconstructor. We found the performance of Carmen to be approximately 5\% lower than that of L\&A.},
	language = {en},
	urldate = {2024-01-30},
	booktitle = {Proc. {SPIE} 9148, {Adaptive} {Optics} {Systems} {IV}, {91484M}},
