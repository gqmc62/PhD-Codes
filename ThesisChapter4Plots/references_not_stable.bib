@inproceedings{sliepen_seeing_2010,
	address = {San Diego, California, USA},
	title = {Seeing measurements with autonomous, short-baseline shadow band rangers},
	url = {http://proceedings.spiedigitallibrary.org/proceeding.aspx?doi=10.1117/12.857643},
	doi = {10.1117/12.857643},
	abstract = {There is growing interest in measuring seeing at existing and prospective telescope sites. Several methods exist to quantify seeing, one among them is by measuring the scintillation of solar or lunar light using a photodiode. A shadow band ranger (SHABAR) analyses the covariance of the signals from an array of such photodiodes, which allows for the spatial resolution of the index of refraction above the SHABAR device. This allows one to estimate the index of refraction structure parameter as a function of height, Cn2(h).},
