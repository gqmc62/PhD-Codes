@inproceedings{rimmele_daniel_2022,
	address = {Montréal, Canada},
	title = {The {Daniel} {K}. {Inouye} {Solar} {Telescope}: status update and first results},
	isbn = {978-1-5106-5345-0 978-1-5106-5346-7},
	shorttitle = {The {Daniel} {K}. {Inouye} {Solar} {Telescope}},
	url = {https://www.spiedigitallibrary.org/conference-proceedings-of-spie/12182/2644469/The-Daniel-K-Inouye-Solar-Telescope--status-update-and/10.1117/12.2644469.full},
	doi = {10.1117/12.2644469},
	abstract = {The National Science Foundation’s 4m Daniel K. Inouye Solar Telescope (DKIST) on Haleakala, Maui is now the largest solar telescope in the world. DKIST’s superb resolution and polarimetric sensitivity will enable astronomers to unravel many of the mysteries the Sun presents, including the origin of solar magnetism, the mechanisms of coronal heating and drivers of flares and coronal mass ejections. Five instruments, four of which provide highly sensitive measurements of solar magnetic fields, including the illusive magnetic field of the faint solar corona. DKIST operates as a coronagraph at infrared wavelengths where the sky background is low and bright coronal emission lines are available. The high-order, single-conjugate adaptive optics system (AO) provides diffraction limited imaging and the ability to resolve features approximately 20 km on the Sun. A multi-conjugate AO upgrade is in progress. With these unique capabilities DKIST will address basic research aspects of Space Weather and help improve predictive capabilities. DKIST has complered construction and is now in the early phases of operations. Community proposal-based shared-risk observations are conducted by the DKIST operations team.},
	language = {en},
	urldate = {2024-07-09},
	booktitle = {Ground-based and {Airborne} {Telescopes} {IX}},
	publisher = {SPIE},
	author = {Rimmele, Thomas R. and Warner, Mark and Casini, Roberto and Kuhn, Jeffery and Lin, Haosheng and Woeger, Friedrich and Tritschler, Alexandra and Davey, Alisdair and De Wijn, Alfred and Fehlmann, Andre and Harrington, David and Jaeggli, Sarah and Schad, Thomas and Anan, Tetsu and Beck, Christian and Marshall, Heather and Jeffers, Paul and Beard, Andrew and Berst, Chris and Cross, Eric and Cummings, Bryan K. and Donneley, Colleen and Eigenbrot, Arthur and Ferayorni, Andrew and Foster, Christopher and Galapon, Chriselle and Goodrich, Bret and Gregory, Brian S. and Guzman, Stephanie and Guzzo, Stephen and Hubbard, John and Johansson, Erik and Johnson, Luke and Liang, Mary and Onodera, Brialyn and Puentes, Myles and Rimmele, Lukas and Starman, Erik and Sueoka, Stacey and Summers, Richard and Szabo, Aimee and Szabo, Louis and Williams, Timothy and White, Charles},
	editor = {Marshall, Heather K. and Spyromilio, Jason and Usuda, Tomonori},
	month = aug,
