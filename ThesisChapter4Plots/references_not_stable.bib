	booktitle = {Adaptive {Optics} {Systems} {VIII}},
	publisher = {SPIE},
	author = {Schmidt, Dirk and Beard, Andrew and Ferayorni, Andrew and Goodrich, Bret D. and Gregory, Scott and Johnson, Luke C. and Rimmele, Lukas and Rimmele, Thomas R. and Starman, Erik and Wöger, Friedrich},
