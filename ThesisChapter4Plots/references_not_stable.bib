	title = {Multiconjugate adaptive optics: comparison of phase reconstruction approaches for large field of view},
	shorttitle = {Multiconjugate adaptive optics},
	url = {http://proceedings.spiedigitallibrary.org/proceeding.aspx?doi=10.1117/12.413820},
	doi = {10.1117/12.413820},
	abstract = {We present, in this article, a analytical study of the phase reconstruction error for MCAO systems. Two approaches are considered; a "classical" estimator based on a Least Square (LS) approach and a Maximum A Posteriori (MAP) estimator which uses the prior knowledge we have both on the measurement noise and the turbulence volume statistics. The effects of these modes both on the phase reconstruction and on the phase correction error are studied and quantified. It is shown that, using a MAP approach, a large part of the unseen modes can be extrapolated using correlations between unseen eigenmode coefficients and well-measured coefficients. We observe that the use of a MAP estimator allows a significant gain in terms of correction quality in the whole field of view.},
	language = {en},
